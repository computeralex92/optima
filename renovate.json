{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One PR for all Go module bumps",
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "description": "One PR for all GitHub Actions bumps (kept digest-pinned)",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "One PR for the Dockerfile base images",
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images"
    }
  ]
}
